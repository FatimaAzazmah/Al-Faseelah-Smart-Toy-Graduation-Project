# Al-Faseelah World — environment variables
# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ElevenLabs API key (https://elevenlabs.io — Profile -> API Keys)
ELEVENLABS_API_KEY=

# Supabase project (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Key used by the AI session, content, and sensor layers.
# Needs read/write access to: children, content, pieces, zones, sessions,
# behavior_goals, behavior_catalog, parent_preferences, achievements,
# child_saved_content (subject to your RLS policies).
SUPABASE_KEY=

# Optional: a separate service-role key for the BLE server.
# Falls back to SUPABASE_KEY when left empty.
SUPABASE_SERVICE_KEY=
